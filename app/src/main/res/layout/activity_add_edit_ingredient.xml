<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F8F3">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/textFormTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Add Ingredient"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#24352A"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Enter the ingredient details below."
            android:textSize="15sp"
            android:textColor="#68736B"
            android:layout_marginBottom="28dp" />

        <EditText
            android:id="@+id/editIngredientName"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:hint="Ingredient name"
            android:inputType="textCapWords"
            android:padding="12dp"
            android:layout_marginBottom="14dp" />

        <EditText
            android:id="@+id/editQuantity"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:hint="Quantity"
            android:inputType="numberDecimal"
            android:padding="12dp"
            android:layout_marginBottom="14dp" />

        <EditText
            android:id="@+id/editUnit"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:hint="Unit (e.g. kg, g, ml, items)"
            android:inputType="text"
            android:padding="12dp"
            android:layout_marginBottom="14dp" />

        <EditText
            android:id="@+id/editExpiryDate"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:hint="Expiry date (optional)"
            android:focusable="false"
            android:clickable="true"
            android:padding="12dp"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tap the expiry field to choose a date."
            android:textSize="13sp"
            android:textColor="#777777"
            android:layout_marginBottom="26dp" />

        <Button
            android:id="@+id/buttonSaveIngredient"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Save Ingredient"
            android:textAllCaps="false"
            android:textStyle="bold"
            android:textSize="16sp" />

        <Button
            android:id="@+id/buttonCancel"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Cancel"
            android:textAllCaps="false"
            android:layout_marginTop="10dp" />

    </LinearLayout>

</ScrollView>

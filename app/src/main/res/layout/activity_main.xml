<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F7F8F3"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Smart Pantry"
        android:textSize="30sp"
        android:textStyle="bold"
        android:textColor="#24352A"
        android:layout_marginTop="20dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Keep track of what you have at home."
        android:textSize="15sp"
        android:textColor="#68736B"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="20dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="20dp">

        <Button
            android:id="@+id/buttonSuggestedRecipes"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="Suggested Recipes"
            android:textAllCaps="false"
            android:textSize="14sp"
            android:layout_marginEnd="6dp" />

        <Button
            android:id="@+id/buttonSettings"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="Settings"
            android:textAllCaps="false"
            android:textSize="14sp"
            android:layout_marginStart="6dp" />

    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="YOUR PANTRY"
        android:textSize="13sp"
        android:textStyle="bold"
        android:textColor="#526158"
        android:layout_marginBottom="12dp" />

    <TextView
        android:id="@+id/textEmptyPantry"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Your pantry is empty.&#10;Add your first ingredient below."
        android:textSize="17sp"
        android:textColor="#68736B"
        android:gravity="center"
        android:padding="30dp"
        android:layout_marginBottom="12dp" />

    <ScrollView
        android:id="@+id/scrollPantry"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/ingredientContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

    </ScrollView>

    <Button
        android:id="@+id/buttonAddIngredient"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="+ Add Ingredient"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textAllCaps="false"
        android:layout_marginTop="16dp" />

</LinearLayout>